# 复制为 .env 后设置部署凭证；此示例不包含真实密钥。
WEB_PORT=8080
DEV_PORT=8080
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
POSTGRES_DB=zhixing
POSTGRES_USER=zhixing
POSTGRES_PASSWORD=replace-with-random-password
APP_DB_USER=zhixing_app
APP_DB_PASSWORD=replace-with-random-password
BUSINESS_DB_USER=zhixing_business_reader
BUSINESS_DB_PASSWORD=replace-with-random-password
INITIAL_ADMIN_PASSWORD=replace-with-random-password
INITIAL_DEMO_PASSWORD=replace-with-random-password
SESSION_COOKIE_SECURE=false
SESSION_HOURS=24
LOGIN_LIMIT_PER_MINUTE=20
MINIO_ROOT_USER=zhixing_root
MINIO_ROOT_PASSWORD=replace-with-random-password
MILVUS_ACCESS_KEY=zhixing_milvus
MILVUS_SECRET_KEY=replace-with-random-password
APP_MINIO_ACCESS_KEY=zhixing_app
APP_MINIO_SECRET_KEY=replace-with-random-password
APP_MINIO_BUCKET=application-files
PRIMARY_BASE_URL=https://api.deepseek.com
PRIMARY_API_KEY=
PRIMARY_MODEL=deepseek-flash
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=qwen3.7-flash-2026-07-15

# 发布前答案审核独立于备用槽位；可填相同值，但以后修改其中一组不会影响另一组。
REVIEW_BASE_URL=
REVIEW_API_KEY=
REVIEW_MODEL=qwen3.8-flash
REVIEW_CONTEXT_TOKENS=1000000

# 可选运行策略；窗口按各型号能力配置，换小窗口模型时同时调整；0使用型号目录或未知型号保守值。
PRIMARY_CONTEXT_TOKENS=1000000
FALLBACK_CONTEXT_TOKENS=1000000
MODEL_CONTEXT_SAFETY_RATIO=0.95
MODEL_OUTPUT_TOKENS=8192
MODEL_READ_TIMEOUT_SECONDS=45
MODEL_RETRY_BACKOFF_SECONDS=0.5
MODEL_CIRCUIT_FAILURES=3
MODEL_CIRCUIT_SECONDS=30
RUN_TIMEOUT_SECONDS=240
WORKER_CONCURRENCY=2
RUN_LEASE_SECONDS=60

# 知识文件上传及隔离解析的资源限制。
KNOWLEDGE_MAX_FILE_BYTES=20971520
KNOWLEDGE_MAX_BATCH_BYTES=52428800
KNOWLEDGE_MAX_FILES=10
KNOWLEDGE_PARSE_TIMEOUT_SECONDS=30

# 真实 CPU 检索模型缓存与混合召回策略，默认通过容器内部服务调用。
MODEL_DOWNLOAD_ENDPOINT=https://huggingface.co
RAG_CHUNK_SIZE=600
RAG_RECALL_LIMIT=20
RAG_RERANK_LIMIT=20
RAG_FINAL_LIMIT=5
RAG_MIN_SCORE=0.3
RAG_RRF_K=60

# M06A 公开搜索：阿里云 IQS 国内极速版；密钥与主备文本模型密钥分开配置。
# 已接入M06A；不填密钥时搜索工具明确返回未配置。
WEB_SEARCH_PROVIDER=aliyun_iqs
WEB_SEARCH_BASE_URL=https://cloud-iqs.aliyuncs.com
WEB_SEARCH_ENGINE_TYPE=CNLiteBasic
WEB_SEARCH_API_KEY=

# 搜索和正文读取限额；当前不启用缓存，超限或失败返回真实状态。
WEB_SEARCH_TIMEOUT_SECONDS=12
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_PAGES=3
WEB_SEARCH_RESPONSE_BYTES=2097152
WEB_SEARCH_TEXT_CHARS=2500
WEB_SEARCH_PER_MINUTE=10

# 专用Docker任务服务，不可用时不在应用执行。
SANDBOX_ENABLED=true
SANDBOX_RUNNER_URL=http://sandbox-runner:8091
SANDBOX_CONTROL_TOKEN=replace-with-random-password

# 沙箱执行额度、持久积压与最长排队时间；多实例扩容在M07C验收。
SANDBOX_RUNNER_CONCURRENCY=1
SANDBOX_GLOBAL_CONCURRENCY=2
SANDBOX_QUEUE_LIMIT=50
SANDBOX_WAIT_SECONDS=300

# M07C副本数与每实例容量独立；留空节点名使用容器自身身份，不给多个副本设置同名。
WORKER_REPLICAS=2
SANDBOX_RUNNER_REPLICAS=2
SANDBOX_RUNNER_ID=
SANDBOX_USER_CONCURRENCY=1
WORKER_SHUTDOWN_SECONDS=60
SANDBOX_SHUTDOWN_SECONDS=70
