# 复制为 .env 后设置部署凭证；此示例不包含真实密钥。
WEB_PORT=8080
DEV_PORT=8080
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
POSTGRES_DB=zhixing
POSTGRES_USER=zhixing
POSTGRES_PASSWORD=replace-with-random-password
APP_DB_USER=zhixing_app
APP_DB_PASSWORD=replace-with-random-password
BUSINESS_DB_USER=zhixing_business_reader
BUSINESS_DB_PASSWORD=replace-with-random-password
INITIAL_ADMIN_PASSWORD=replace-with-random-password
INITIAL_DEMO_PASSWORD=replace-with-random-password
SESSION_COOKIE_SECURE=false
SESSION_HOURS=24
LOGIN_LIMIT_PER_MINUTE=20
MINIO_ROOT_USER=zhixing_root
MINIO_ROOT_PASSWORD=replace-with-random-password
MILVUS_ACCESS_KEY=zhixing_milvus
MILVUS_SECRET_KEY=replace-with-random-password
APP_MINIO_ACCESS_KEY=zhixing_app
APP_MINIO_SECRET_KEY=replace-with-random-password
APP_MINIO_BUCKET=application-files
PRIMARY_BASE_URL=https://api.deepseek.com
PRIMARY_API_KEY=
PRIMARY_MODEL=deepseek-flash
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=qwen-plus

# 可选运行策略；主备模型接入仍仅需各自的 URL、密钥、模型名。
PRIMARY_CONTEXT_TOKENS=0
FALLBACK_CONTEXT_TOKENS=0
MODEL_OUTPUT_TOKENS=2048
MODEL_READ_TIMEOUT_SECONDS=45
MODEL_RETRY_BACKOFF_SECONDS=0.5
MODEL_CIRCUIT_FAILURES=3
MODEL_CIRCUIT_SECONDS=30
RUN_TIMEOUT_SECONDS=240
WORKER_CONCURRENCY=2
RUN_LEASE_SECONDS=60

# 知识文件上传及隔离解析的资源限制。
KNOWLEDGE_MAX_FILE_BYTES=20971520
KNOWLEDGE_MAX_BATCH_BYTES=52428800
KNOWLEDGE_MAX_FILES=10
KNOWLEDGE_PARSE_TIMEOUT_SECONDS=30

# 真实 CPU 检索模型缓存与混合召回策略，默认通过容器内部服务调用。
MODEL_DOWNLOAD_ENDPOINT=https://huggingface.co
RAG_CHUNK_SIZE=600
RAG_RECALL_LIMIT=20
RAG_RERANK_LIMIT=20
RAG_FINAL_LIMIT=5
RAG_MIN_SCORE=0.3
RAG_RRF_K=60
