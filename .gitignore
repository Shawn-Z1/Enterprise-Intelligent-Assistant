# 本机环境、密钥与开发工具配置；环境示例仍随仓库分发。
.env
.env.*
!.env.example
.venv/
venv/
.idea/
.vscode/

# 可重复安装的依赖、构建输出及工具缓存。
**/node_modules/
frontend/dist/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.vite/
*.tsbuildinfo
.coverage
.coverage.*
htmlcov/
coverage/

# 本地开发文档、验收记录及截图，不属于部署交付物。
/verification/
/docs/

# 本机 AI 协作规则与阶段验收工具，不随部署源码发布；文件留在本地。
/AGENTS.md
/.cursor/
/.agents/
/.codex/
/backend/tests/
/backend/requirements-dev.txt
/scripts/verify-*
/scripts/observe-*

# 本机上传资料、导出和数据库档案，避免手误加入公开仓库。
/uploads/
/exports/
/local-data/
*.dump
*.backup
*.pem
*.key
*.p12

# 本地运行数据、镜像导出、备份和日志；正式种子 SQL 仍保留。
/volumes/
/backups/
/minio-*.tar
*.log
*.pid

# 分词器下载缓存通过版本清单和构建脚本重建，不将大词表纳入Git。
/backend/tokenizer_assets/*.json.cache
/backend/tokenizer_assets/deepseek-v41.json

# 操作系统生成的文件。
.DS_Store
Thumbs.db
Desktop.ini
